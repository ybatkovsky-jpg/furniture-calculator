# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Окружение: dev | prod. При ENV=prod пустой ADMIN_TELEGRAM_IDS — ошибка
# конфигурации (бот не стартует): управлять прайсом было бы некому.
ENV=dev

# Администраторы — ID пользователей через запятую, которым доступны
# команды управления прайсом (/price_upload, /price_edit, /price_list).
# Узнать свой ID: напишите боту @userinfobot.
# ВАЖНО: пусто = админов НЕТ (fail-closed, P0-05). Раньше пусто означало
# «все админы» — это была уязвимость: прайс мог заменить любой пользователь.
ADMIN_TELEGRAM_IDS=

# Allowlist пользователей бота (ID через запятую). Пусто — доступ разрешён
# всем; заполнено — только перечисленным и админам. Используйте, чтобы
# ограничить круг лиц, допущенных к ПДн клиентов.
ALLOWED_TELEGRAM_IDS=

# Vision LLM — Z.ai (основной: GLM-4.6V с object detection)
# Регистрация: https://z.ai → API Keys
ZAI_API_KEY=your-zai-key-here
# Модель: glm-4.6v (object detection с bounding boxes)
VISION_MODEL=glm-4.6v
VISION_API_URL=https://api.z.ai/api/paas/v4/chat/completions

# OCR-заземление габарита: числа с размерных линий читает OCR
# (GLM-OCR через ZAI_API_KEY или локальный Tesseract), а не догадка VLM.
# false — конвейер работает как раньше (только ответ модели)
OCR_DIMENSIONS_ENABLED=true

# Локальный LLM-сервер (OpenAI-совместимый: Unsloth Studio / llama.cpp с Qwen GGUF).
# Пусто — выключено. Если задан — локальная модель становится провайдером №1.
LOCAL_LLM_API_URL=
LOCAL_VISION_MODEL=orcarouter/Qwen3.8-27B-Uncensored-GGUF
LOCAL_LLM_API_KEY=

# DeepSeek Vision (облако, OpenAI-совместимый). DeepSeek-V4.1-Flash принимает изображения.
# ВАЖНО: нужны response_format=json_object и max_tokens≈32000 — иначе reasoning
# съедает бюджет и JSON не приходит (это уже вшито в image_analyzer._unified_body).
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# RouterAI.ru — агрегатор (Qwen3-VL) для ансамбля и резерва
ROUTERAI_API_KEY=
ROUTERAI_API_URL=https://routerai.ru/api/v1/chat/completions

# Приоритетный провайдер распознавания: local | deepseek | routerai.
# Пусто — авто: local → deepseek → routerai (первый живой). Остальные остаются резервом.
VISION_PROVIDER=

# OpenRouter (запасной: Qwen3-VL-235B)
OPENROUTER_API_KEY=sk-or-v1-...

# Gemini Flash (устаревший routerai.ru)
GEMINI_API_KEY=AIza...

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/furniture.db

# Импорт проектов: исходники, страницы, project.json (этап 1)
PROJECTS_DIR=data/projects
IMPORT_MAX_IMAGE_MB=20
IMPORT_MAX_PDF_MB=50

# Коэффициенты расчёта (значения на 24.11.2026; политика — docs/financial_policy_v1.0.md)
MANUFACTURING_RATE=0.80
INSTALLATION_RATE=0.15
DESIGN_RATE=0.10
OVERHEAD_RATE=0.05
PROFIT_RATE=0.35
TECH_DIRECTOR_RATE=0.015
MANAGER_RATE=0.0
DESIGNER_RATE=0.0
MEASUREMENT_FEE=2500
DELIVERY_FEE=6500
DELIVERY_FEE_CLIENT=10000
NONCASH_MARKUP=1.10
SHEET_UTILIZATION=0.85
MIN_MARGIN_RATE=0.15
MAX_DISCOUNT_PERCENT=10
SHEET_RESERVE_RATE=0.30
# Этап 3: листы и кромка по физическим деталям (Part), а не по старым линиям BOM.
# 0 — текущий расчёт, 1 — Part-раскрой. Включать после сверки.
PART_BOM_PRICING=1
# Кромка по Part — только после совпадения правил со старым расчётом.
PART_BOM_EDGE=0
RISK_RESERVE_RATE=0.0

# Бонус дизайнера (по умолчанию)
DESIGNER_BONUS_RATE=0.10

# Настройки компании для КП
COMPANY_NAME=Мебельная Компания
COMPANY_ADDRESS=г. Хабаровск, ул. Дикопольцева, 7а
COMPANY_PHONE=+7 999 256 3879
COMPANY_EMAIL=pro.mebel25@mail.ru
KP_NUMBER_PREFIX=КП-

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Администраторы — ID пользователей через запятую, которым доступны
# команды управления прайсом (/price_upload, /price_edit).
# Узнать свой ID: напишите боту @userinfobot.
# Если пусто — команды открыты всем (как было раньше, НЕ рекомендуется для прода).
ADMIN_TELEGRAM_IDS=

# Vision LLM — Z.ai (основной: GLM-4.6V с object detection)
# Регистрация: https://z.ai → API Keys
ZAI_API_KEY=your-zai-key-here
# Модель: glm-4.6v (object detection с bounding boxes)
VISION_MODEL=glm-4.6v
VISION_API_URL=https://api.z.ai/api/paas/v4/chat/completions

# OCR-заземление габарита: числа с размерных линий читает OCR
# (GLM-OCR через ZAI_API_KEY или локальный Tesseract), а не догадка VLM.
# false — конвейер работает как раньше (только ответ модели)
OCR_DIMENSIONS_ENABLED=true

# OpenRouter (запасной: Qwen3-VL-235B)
OPENROUTER_API_KEY=sk-or-v1-...

# Gemini Flash (устаревший routerai.ru)
GEMINI_API_KEY=AIza...

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/furniture.db

# Коэффициенты расчёта
MANUFACTURING_RATE=0.80
INSTALLATION_RATE=0.55
DESIGN_RATE=0.10
OVERHEAD_RATE=0.05
PROFIT_RATE=0.30
TECH_DIRECTOR_RATE=0.015
MANAGER_RATE=0.0
DESIGNER_RATE=0.0
MEASUREMENT_FEE=2500
DELIVERY_FEE=6500
DELIVERY_FEE_CLIENT=10000
NONCASH_MARKUP=1.13
SHEET_UTILIZATION=0.85

# Бонус дизайнера (по умолчанию)
DESIGNER_BONUS_RATE=0.10

# Настройки компании для КП
COMPANY_NAME=Мебельная Компания
COMPANY_ADDRESS=г. Хабаровск, ул. Дикопольцева, 7а
COMPANY_PHONE=+7 999 256 3879
COMPANY_EMAIL=pro.mebel25@mail.ru
KP_NUMBER_PREFIX=КП-
